# Bloquea los archivos de trabajo del tema.
#
# El repositorio ES el directorio del tema, asi que todo lo que vive aqui se
# publica en wp-content/themes/TOCTOC-1/. El 10 de septiembre de 2026 se
# comprobo que SEO-CONTEXTO.md respondia 200 a cualquiera: once kilobytes de
# notas internas — IDs de propiedades de GA4 y Search Console, como filtramos
# los bots, y observaciones sobre sitios de clientes. Tambien MARCA-Y-MERCADO.md,
# package.json y tailwind.config.js.
#
# Ninguno lleva credenciales (esas se guardan deliberadamente fuera del repo),
# pero son documentos de trabajo y no tienen por que ser legibles desde fuera.
#
# Se listan por extension y por nombre exacto, nunca *.js entero: eso tumbaria
# los scripts del tema.

<FilesMatch "\.(md|lock|sh|py|yml|yaml|dist|log|sql|bak)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

<FilesMatch "^(package(-lock)?\.json|composer\.(json|lock)|tailwind\.config\.js|postcss\.config\.js|\.gitignore|\.gitattributes|\.env.*|README.*)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
